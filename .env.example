# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.)
# When you add the Postgres/Neon storage integration in Vercel, copy the
# connection string it gives you here too so local dev uses the same DB.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

PORT=3000

# Admin login for the site's dashboard
ADMIN_EMAIL="admin@mrlwoodworking.com"
ADMIN_PASSWORD="mrl2025!"

# Random long string used to sign login sessions (change in production)
JWT_SECRET="change-this-to-a-long-random-string"

# Contact form (sends email via Gmail using Nodemailer)
# EMAIL_USER must be a Gmail address with an App Password (not the regular password):
# 1. Enable 2-Step Verification at myaccount.google.com/security
# 2. Create an App Password at myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (no spaces)
EMAIL_USER="mrlwoodworkinginc@gmail.com"
EMAIL_PASS="your-16-character-app-password"
CONTACT_EMAIL="mrlwoodworkinginc@gmail.com"
